{
    "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
    "customizations": {
        "vscode": {
            "settings": {
                "json.schemas": [
                    {
                        "fileMatch": [
                            "*/devcontainer-feature.json"
                        ],
                        "url": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainerFeature.schema.json"
                    }
                ],
                "nix.enableLanguageServer": true,
                "nix.serverPath": "nixd",
                "nix.serverSettings": {
                    "nixd": {
                        "formatting": {
                            "command": [
                                "nixfmt"
                            ]
                        }
                    }
                }
            },
            "extensions": [
                "jnoortheen.nix-ide",
                "mads-hartmann.bash-ide-vscode",
                "nefrob.vscode-just-syntax"
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils": {
            "configureZshAsDefaultShell": true,
            "installOhMyZsh": true
        },
        "ghcr.io/devcontainers/features/docker-in-docker:4": {},
        "ghcr.io/devcontainers/features/nix:1": {
            "multiUser": true,
            "packages": "just,just-lsp,nixpkgs.nixd,nixpkgs.nixfmt-rfc-style",
            "useAttributePath": true,
            "version": "latest",
            "extraNixConfig": "experimental-features = nix-command flakes"
        }
    },
    "remoteUser": "node",
    "updateContentCommand": {
        // There's no feature for this, so …
        "devcontainer-cli": "npm install -g @devcontainers/cli",
        // Ensure the profile exists without needing to install anything
        "nix-profile": "nix-env -i $(nix-instantiate -E 'with import <nixpkgs> {}; buildEnv { name = \"profile\"; paths = []; }')"
    }
}
